# Pooled Postgres connection string (e.g. Neon's pgbouncer proxy). Consumed
# by lib/db.ts via @onewash/db's `db(url)` client factory.
DATABASE_URL=

# Direct (non-pooled) Postgres connection string. Only needed for running
# migrations (`pnpm --filter @onewash/web db:migrate`), never at request time.
DATABASE_URL_DIRECT=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google OAuth (Better Auth social provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (Better Auth social provider)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
