# Pooled Postgres connection string (e.g. Neon's pgbouncer proxy). Consumed
# by lib/db.ts via @buer/db's `db(url)` client factory.
DATABASE_URL=

# Direct (non-pooled) Postgres connection string. Only needed for running
# migrations (`pnpm --filter @buer/web db:migrate`), never at request time.
DATABASE_URL_DIRECT=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google OAuth (Better Auth social provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (Better Auth social provider)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public base URL the mirrored assets (packages/gi-data's assets:sync
# manifest) are served from, e.g. an R2 public bucket domain. Optional —
# lib/render.ts's resolveAssetUrl() falls back to the original HoYoLAB/Enka
# CDN URL when this is unset or a given URL isn't in the manifest yet (see
# design spec §4.2/§9 spike 5 — image hosting isn't finalized in Fase 1).
NEXT_PUBLIC_ASSETS_BASE_URL=
